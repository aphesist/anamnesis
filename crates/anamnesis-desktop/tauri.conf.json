{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anamnesis",
  "mainBinaryName": "anamnesis-desktop",
  "identifier": "ist.aphes.anamnesis",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "publisher": "the anamnesis authors",
    "copyright": "Copyright 2026 the anamnesis authors. Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "a local-first second brain",
    "longDescription": "anamnesis: your notes, folders, vaults, feeds and chats as one brain that stays on your machine, with built-in evaluation and an mcp server for your ai harnesses.",
    "homepage": "https://github.com/aphesist/anamnesis",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    }
  }
}
