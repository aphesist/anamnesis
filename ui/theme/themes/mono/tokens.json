{
  "$description": "mono: values shared by both modes.",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "text": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "type": {
    "display-slant": {
      "$type": "number",
      "$value": 0
    },
    "display-weight": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking": {
      "$type": "number",
      "label": {
        "$value": 0.04
      },
      "meta": {
        "$value": 0.02
      }
    }
  },
  "dur": {
    "$type": "duration",
    "short": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "mid": {
      "$value": {
        "value": 300,
        "unit": "ms"
      }
    },
    "long": {
      "$value": {
        "value": 500,
        "unit": "ms"
      }
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "$value": [
      0.3,
      0,
      0.2,
      1
    ]
  }
}
