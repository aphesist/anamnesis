{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anamnesis.local/ui/theme/layouts/layout.schema.json",
  "title": "anamnesis layout",
  "description": "which panels exist, where they sit, their order and whether they start open. ui/app builds its panels from this; settings edits it.",
  "type": "object",
  "required": [
    "version",
    "panels"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "region",
          "order",
          "open",
          "visible"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "stable panel id the app knows (unknown ids are ignored by the app)."
          },
          "label": {
            "type": "string",
            "description": "lowercase name shown in settings."
          },
          "region": {
            "enum": [
              "left",
              "right",
              "bottom",
              "overlay"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "description": "order inside its region, ascending."
          },
          "open": {
            "type": "boolean",
            "description": "starts expanded (true) or collapsed (false)."
          },
          "visible": {
            "type": "boolean",
            "description": "false removes the panel from the screen entirely (still reachable from settings)."
          },
          "anchor": {
            "enum": [
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right",
              "left",
              "right",
              "center"
            ],
            "description": "overlay panels only: where they float."
          },
          "size": {
            "type": "number",
            "minimum": 0,
            "description": "preferred width (left/right/overlay) or height (bottom) in css px."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "default sections inside the panel, in order."
          }
        }
      }
    }
  }
}
